<Window x:Class="MediaRescue.App.MainWindow" Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MediaRescue.App.Views"
        Style="{StaticResource AppWindow}"
        Title="Extrator de Mídias"
        Width="1240" Height="820" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Language="pt-BR">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding Extract.Progress.Visual, Converter={StaticResource VisualToTaskbar}}"
                         ProgressValue="{Binding Extract.Progress.TaskbarValue}"/>
    </Window.TaskbarItemInfo>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding GoExtractCommand}"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding GoHistoryCommand}"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding GoDiagnosticsCommand}"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding GoSettingsCommand}"/>
        <KeyBinding Key="F5" Command="{Binding Extract.RefreshCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: navigation + batch mode switch -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,28,0" VerticalAlignment="Center">
                    <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Brush.Accent}" Margin="0,2,10,0"/>
                    <TextBlock Text="Extrator de Mídias" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton GroupName="nav" Style="{StaticResource NavTab}" Content="Extrair" IsChecked="{Binding IsExtractPage, Mode=TwoWay}" AutomationProperties.Name="Extrair (Ctrl+1)"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavTab}" Content="Histórico" IsChecked="{Binding IsHistoryPage, Mode=TwoWay}" AutomationProperties.Name="Histórico (Ctrl+2)"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavTab}" Content="Testar leitor" IsChecked="{Binding IsDiagnosticsPage, Mode=TwoWay}" AutomationProperties.Name="Testar leitor (Ctrl+3)"/>
                    <RadioButton GroupName="nav" Style="{StaticResource NavTab}" Content="Configurações" IsChecked="{Binding IsSettingsPage, Mode=TwoWay}" AutomationProperties.Name="Configurações (Ctrl+4)"/>
                </StackPanel>
                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" Content="Modo lote" VerticalAlignment="Center"
                          IsChecked="{Binding Extract.Batch.IsEnabled, Mode=TwoWay}"
                          ToolTip="Processa vários discos em sequência: só pergunta o nome de cada um."
                          AutomationProperties.Name="Modo lote"/>
            </Grid>
        </Border>

        <!-- Pages (all alive, so scroll position and typed text survive navigation) -->
        <Grid Grid.Row="1">
            <v:ExtractView DataContext="{Binding Extract}" Visibility="{Binding DataContext.IsExtractPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
            <v:HistoryView DataContext="{Binding History}" Visibility="{Binding DataContext.IsHistoryPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
            <v:DiagnosticsView DataContext="{Binding Diagnostics}" Visibility="{Binding DataContext.IsDiagnosticsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
            <v:SettingsView DataContext="{Binding SettingsPage}" Visibility="{Binding DataContext.IsSettingsPage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Live log -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid Margin="20,8,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="REGISTRO" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                <Button Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Content="Abrir log" Command="{Binding OpenLogCommand}" VerticalAlignment="Top" Style="{StaticResource GhostButton}"/>
                <!-- exactly three whole lines (3 x 18): scrolls line by line, so the first visible line is never cut in half -->
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Log.Lines}" Style="{StaticResource PlainList}" Height="54" ClipToBounds="True"
                         VirtualizingPanel.ScrollUnit="Item"
                         AutomationProperties.Name="Registro de atividades" IsTabStop="False">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12.5" TextTrimming="CharacterEllipsis" Height="18" Padding="0,1.5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Brush.Warn}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>

