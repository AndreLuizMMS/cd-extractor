<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Text/background pairs are AA (>= 4.5:1). -->
    <SolidColorBrush x:Key="Brush.Window" Color="#12161B"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#1B2128"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#171C22"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#2E3742"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#7C8796"/>
    <SolidColorBrush x:Key="Brush.Text" Color="#E8EDF3"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#A5B0BE"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#5BA8F5"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#78B8F7"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#4C98E4"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#0B1620"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1C2F45"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#242C35"/>
    <SolidColorBrush x:Key="Brush.Pressed" Color="#2C3641"/>
    <SolidColorBrush x:Key="Brush.Ok" Color="#5ED58A"/>
    <SolidColorBrush x:Key="Brush.OkSoft" Color="#17301F"/>
    <SolidColorBrush x:Key="Brush.Warn" Color="#E8B94A"/>
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="#33290F"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF8A80"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#3A1A18"/>
    <SolidColorBrush x:Key="Brush.TrackBg" Color="#2E3742"/>
    <SolidColorBrush x:Key="Brush.Scroll" Color="#4A5563"/>
    <SolidColorBrush x:Key="Brush.ScrollHover" Color="#6C7888"/>
    <SolidColorBrush x:Key="Brush.Shadow" Color="#66000000"/>
</ResourceDictionary>
