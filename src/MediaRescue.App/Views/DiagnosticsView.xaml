<UserControl x:Class="MediaRescue.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MediaRescue.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="20,16,20,16">
            <!-- left-aligned like the other pages (title at the same x), but never wider than 980 -->
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="980"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Testar leitor" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                               Text="Verifica se o leitor responde, abre a bandeja, reconhece o disco e consegue ler. Se algo falhar, você vê o que fazer."/>
                </StackPanel>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="LEITOR" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DriveText}" FontSize="16" FontWeight="SemiBold"/>
                            <CheckBox Content="Teste completo da superfície do disco (demorado: pode levar vários minutos)" IsChecked="{Binding FullScan}" Margin="0,12,0,0"
                                      IsEnabled="{Binding IsRunning, Converter={StaticResource NotConverter}}"/>
                            <CheckBox Content="Testar também a bandeja (abre a bandeja e ejeta o disco que estiver no leitor)" IsChecked="{Binding IncludeTrayTest}" Margin="0,8,0,0"
                                      IsEnabled="{Binding IsRunning, Converter={StaticResource NotConverter}}"/>
                            <TextBlock Text="{Binding RunDisabledReason}" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                       Visibility="{Binding RunDisabledReason, Converter={StaticResource HasValueToVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="Cancelar teste" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Testar leitor" Command="{Binding RunCommand}" Style="{StaticResource BigPrimaryButton}" MinWidth="160"
                                    AutomationProperties.Name="Testar o leitor"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToneBox}" ui:Ui.Tone="{Binding SummaryTone}" Margin="0,16,0,0"
                        Visibility="{Binding HasRun, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SummaryText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button Grid.Column="1" Content="Copiar relatório" Command="{Binding CopyReportCommand}" Margin="16,0,0,0"
                                AutomationProperties.Name="Copiar o relatório do teste"/>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center" FontSize="15" Margin="0,48,0,0" MaxWidth="460"
                           Text="Ainda não há resultados. Clique em “Testar leitor” para começar."
                           Visibility="{Binding HasRun, Converter={StaticResource InvBoolToVis}}"/>

                <ItemsControl ItemsSource="{Binding Checks}" Margin="0,12,0,0" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top" HorizontalAlignment="Left"
                                            Style="{StaticResource ToneBox}" ui:Ui.Tone="{Binding Tone}" Padding="0">
                                        <TextBlock Text="{Binding Icon}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Style="{StaticResource ToneText}" ui:Ui.Tone="{Binding Tone}" AutomationProperties.Name="{Binding OutcomeText}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="15">
                                            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding OutcomeText, Mode=OneWay, StringFormat=' — {0}'}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,3,0,0"
                                                   Visibility="{Binding Detail, Converter={StaticResource HasValueToVis}}"/>
                                        <Border Style="{StaticResource ToneBox}" ui:Ui.Tone="Accent" Margin="0,8,0,0" Padding="10,6"
                                                Visibility="{Binding HasTip, Converter={StaticResource BoolToVis}}">
                                            <TextBlock TextWrapping="Wrap" FontSize="13.5"><Run Text="O que fazer: " FontWeight="SemiBold"/><Run Text="{Binding Tip, Mode=OneWay}"/></TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Card}" Margin="0,6,0,16" Visibility="{Binding ShowGeneralTips, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="DICAS PARA LEITORES USB FINOS" Style="{StaticResource SectionLabel}"/>
                        <ItemsControl ItemsSource="{Binding GeneralTips}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="• "/><Run Text="{Binding Mode=OneWay}"/></TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
