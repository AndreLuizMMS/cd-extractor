<UserControl x:Class="MediaRescue.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MediaRescue.App.Infrastructure">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Histórico" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Atualizar" Command="{Binding RefreshCommand}"/>
                <Button Content="Exportar CSV…" Command="{Binding ExportCommand}" Margin="8,0,0,0" AutomationProperties.Name="Exportar o histórico para uma planilha CSV"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid HorizontalAlignment="Left" Width="460">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pesquisar no histórico" ToolTip="Pesquise por nome, data, estado ou pasta"/>
                <TextBlock Text="Pesquisar por nome, data, estado ou pasta…" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}" Visibility="{Binding SearchText, Converter={StaticResource IsEmptyToVis}}"/>
            </Grid>
            <Border Style="{StaticResource ToneBox}" ui:Ui.Tone="Warn" Margin="0,12,0,0" Visibility="{Binding Warning, Converter={StaticResource HasValueToVis}}">
                <TextBlock Text="{Binding Warning}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12,16,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Nome" Margin="10,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Grid.Column="1" Text="Data" Foreground="{DynamicResource Brush.TextMuted}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Grid.Column="2" Text="Tamanho" Foreground="{DynamicResource Brush.TextMuted}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Grid.Column="3" Text="Perdido" Foreground="{DynamicResource Brush.TextMuted}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Grid.Column="4" Text="Estado" Foreground="{DynamicResource Brush.TextMuted}" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock Grid.Column="5" Text="Pasta de destino" Foreground="{DynamicResource Brush.TextMuted}" FontWeight="SemiBold" FontSize="13"/>
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Style="{StaticResource PlainList}"
                         AutomationProperties.Name="Discos já extraídos">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="160"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*" MinWidth="160"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Margin="10,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding DateText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding LostText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold"
                                           Style="{StaticResource ToneText}" ui:Ui.Tone="{Binding Tone}"/>
                                <TextBlock Grid.Column="5" Text="{Binding Path}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,0,8,0"/>
                                <Button Grid.Column="6" Content="Abrir pasta" Padding="10,2" MinHeight="28" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="Abrir a pasta deste disco"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Style="{StaticResource MutedText}" FontSize="15" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                           Visibility="{Binding EmptyText, Converter={StaticResource HasValueToVis}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

