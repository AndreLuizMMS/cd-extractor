<Window x:Class="MediaRescue.App.Views.MessageDialogWindow" Icon="/Assets/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:MediaRescue.App.Infrastructure"
        Style="{StaticResource AppWindow}"
        Width="540" MinWidth="440" MaxWidth="700" MaxHeight="760"
        SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Title="Extrator de Mídias">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,26,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="IconBox" Grid.Column="0" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top" Margin="0,2,18,0"
                    Style="{StaticResource ToneBox}" Padding="0">
                <TextBlock x:Name="IconGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold"
                           Style="{StaticResource ToneText}" AutomationProperties.Name="Ícone"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="MessageText" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                         Padding="0" MinHeight="0" VerticalContentAlignment="Top" Focusable="False" MaxHeight="360"
                         VerticalScrollBarVisibility="Auto" IsTabStop="False"/>
                <Expander x:Name="DetailsExpander" Header="Detalhes" Style="{StaticResource DetailsExpander}" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" Padding="8,6" VerticalContentAlignment="Top"/>
                </Expander>
                <CheckBox x:Name="Check" Margin="0,16,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,14">
            <StackPanel x:Name="ButtonBar" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</Window>
