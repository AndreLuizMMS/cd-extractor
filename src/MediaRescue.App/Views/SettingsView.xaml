<UserControl x:Class="MediaRescue.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="20,16,20,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Configurações" Style="{StaticResource PageTitle}" Margin="0,0,0,14"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="CÓPIA E SEGURANÇA" Style="{StaticResource SectionLabel}"/>

                    <CheckBox IsChecked="{Binding VerifyAfterCopy}" Content="Verificar cada arquivo depois de copiar (recomendado)"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="26,2,0,0"
                               Text="O programa relê o arquivo gravado e confere se ficou idêntico ao do disco. Desligar deixa a cópia mais rápida, mas um pendrive defeituoso pode passar despercebido."/>

                    <CheckBox IsChecked="{Binding ReduceSpeedOnError}" Margin="0,16,0,0" Content="Reduzir a velocidade do leitor quando houver erros de leitura"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="26,2,0,0"
                               Text="Leitores mais lentos costumam conseguir ler setores difíceis de discos riscados."/>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tentativas por trecho com erro"/>
                            <TextBlock Style="{StaticResource HintText}" Text="Quantas vezes insistir em um trecho difícil antes de desistir dele (1 a 10)."/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding RetriesPerSector, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"
                                 AutomationProperties.Name="Tentativas por trecho com erro"/>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tempo máximo por leitura (segundos)"/>
                            <TextBlock Style="{StaticResource HintText}" Text="Se o leitor não responder neste tempo, o trecho é tratado como ilegível (5 a 300)."/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding BlockTimeoutSeconds, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"
                                 AutomationProperties.Name="Tempo máximo por leitura em segundos"/>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tempo para recuperar trechos com erro (minutos)"/>
                            <TextBlock Style="{StaticResource HintText}" Text="Limite por disco para a segunda tentativa nos trechos difíceis. Pode ser estendido durante a cópia com “Insistir mais”. Valores de 1 a 600."/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource NumberBox}" Text="{Binding SecondPassBudgetMinutes, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"
                                 AutomationProperties.Name="Tempo para recuperar trechos com erro em minutos"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="AO TERMINAR E NO MODO LOTE" Style="{StaticResource SectionLabel}"/>
                    <CheckBox IsChecked="{Binding EjectWhenDone}" Content="Ejetar o disco ao concluir a cópia"/>
                    <CheckBox IsChecked="{Binding BatchAskName}" Margin="0,14,0,0" Content="No modo lote, perguntar o nome de cada disco"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="26,2,0,0"
                               Text="Desligado: o programa usa sempre o nome sugerido (o rótulo do disco ou a data de gravação)."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="APARÊNCIA" Style="{StaticResource SectionLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Tema" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Value" SelectedValue="{Binding Theme}"
                                  AutomationProperties.Name="Tema">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="CONVERSÃO" Style="{StaticResource SectionLabel}"/>
                    <CheckBox IsChecked="{Binding ConvertToMp4}" IsEnabled="{Binding Mp4Available}" Content="Converter os vídeos para MP4 depois da cópia"/>
                    <TextBlock Style="{StaticResource HintText}" Margin="26,2,0,0" Text="{Binding Mp4Note}"/>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource HintText}" Margin="2,16,0,0"
                       Text="As configurações são salvas automaticamente neste computador. O programa não usa a internet."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

